# ESPHome build output and git caches
.esphome/
# ESPHome writes this file; this root file already ignores what it lists
examples/.gitignore
# Your own secrets (see examples/secrets.example.yaml)
secrets.yaml
# Python
__pycache__/
*.pyc
.pytest_cache/
# macOS
.DS_Store
# Python package builds
build/
*.egg-info/
.complexipy_cache/
mutants/
# Habitica sprites the habitica persona downloads while it builds. They are
# CC-BY-NC-SA art: never commit them (docs: pixel/persona-habitica).
daruma_habitica/
