{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.esphome/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "ESPHome pins in user-facing docs and scripts (uvx --from esphome==...). pyproject.toml and uv.lock go through the pep621 manager",
      "managerFilePatterns": [
        "/\\.(py|md|sh)$/"
      ],
      "matchStrings": [
        "esphome==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "esphome",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "The ESPHome version the README and the install guide ask for",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/install\\.md$/"
      ],
      "matchStrings": [
        "ESPHome (?<currentValue>\\d+\\.\\d+\\.\\d+) or later"
      ],
      "depNameTemplate": "esphome",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Python tools pinned with == in .gitlint and .pre-commit-config.yaml (the rest are in pyproject.toml)",
      "managerFilePatterns": [
        "/^\\.gitlint$/",
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>gitlint-core|lizard|clang-tidy|pre-commit)==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "One update for every place that names the ESPHome version",
      "matchDepNames": [
        "esphome"
      ],
      "groupName": "ESPHome"
    },
    {
      "description": "aioesphomeapi (pyproject.toml) follows ESPHome's API; update it with ESPHome",
      "matchDepNames": [
        "aioesphomeapi"
      ],
      "groupName": "ESPHome"
    },
    {
      "description": "gitlint in pre-commit and in CI moves as one",
      "matchDepNames": [
        "gitlint-core",
        "jorisroovers/gitlint"
      ],
      "groupName": "gitlint"
    },
    {
      "description": "The Python pin in .python-version: one pull request per minor release, on a monthly schedule",
      "matchManagers": [
        "pyenv"
      ],
      "groupName": "Python",
      "schedule": [
        "* 0-6 1 * *"
      ]
    },
    {
      "description": "clang-format (pre-commit mirror) and clang-tidy (CI) move as one LLVM version",
      "matchDepNames": [
        "pre-commit/mirrors-clang-format",
        "clang-tidy"
      ],
      "groupName": "LLVM tools"
    }
  ],
  "semanticCommits": "enabled",
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-6 * * 1"
    ]
  }
}
